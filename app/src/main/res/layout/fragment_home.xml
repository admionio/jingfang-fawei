<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundLight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 首页标题栏 ===== -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarHome"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 夜间模式快速切换按钮 -->
                <ImageView
                    android:id="@+id/ivNightToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- 搜索栏 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/backgroundSearch">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_search"
                    android:tint="@color/textSecondary" />

                <TextView
                    android:id="@+id/tvSearchHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="40dp"
                    android:text="@string/search_hint"
                    android:textColor="@color/textHint"
                    android:textSize="15sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== 时间区域 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <!-- 第1行：实时时钟 HH:mm:ss -->
            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:textColor="@color/homeClock"
                android:fontFeatureSettings="tnum"
                android:typeface="serif"
                android:textStyle="bold" />

            <!-- 间距 8dp -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- 第2行：公历日期 xxxx年x月x日 星期x -->
            <TextView
                android:id="@+id/tvDateSolar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/homeDateSolar"
                android:typeface="serif" />

            <!-- 间距 8dp -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- 第3行A：农历 -->
            <TextView
                android:id="@+id/tvDateLunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/homeDateLunar"
                android:typeface="serif" />

            <!-- 间距 4dp -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <!-- 第3行B：时辰 -->
            <TextView
                android:id="@+id/tvShichen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/homeShichen"
                android:typeface="serif" />

            <!-- 下边距 16dp -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>

        <!-- 分隔线（左右24dp边距） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="24dp"
            android:background="@color/homeDivider" />

        <!-- 分隔线下间距 4dp -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <!-- ===== 今日推荐 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/today_recommend"
            android:textColor="@color/homeSectionTitle"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvTodayRecommend"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRecommendTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvRecommendExcerpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== 素问/灵枢卡片 ===== -->

        <!-- 素问卡片 160dp -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvSuwen"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:backgroundTint="@color/backgroundCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:gravity="center_vertical">

                <!-- 左：图标区域 48dp×48dp -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    app:srcCompat="@drawable/ic_suwen"
                    android:scaleType="center"
                    android:background="@drawable/bg_history_tag"
                    android:backgroundTint="@color/colorPrimary" />

                <!-- 中：标题+副标题 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvSuwenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_suwen"
                        android:textSize="22sp"
                        android:textColor="@color/homeSuwenTitle"
                        android:typeface="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/suwen_subtitle"
                        android:textSize="13sp"
                        android:textColor="@color/homeSuwenSubtitle"
                        android:typeface="serif"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 右：统计+进度 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvSuwenCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/homeSuwenCount"
                        android:typeface="serif" />

                    <TextView
                        android:id="@+id/tvSuwenProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/homeSuwenProgress"
                        android:typeface="serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="→"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 灵枢卡片 160dp -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvLingshu"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:backgroundTint="@color/backgroundCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:gravity="center_vertical">

                <!-- 左：图标区域 48dp×48dp -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    app:srcCompat="@drawable/ic_lingshu"
                    android:scaleType="center"
                    android:background="@drawable/bg_history_tag"
                    android:backgroundTint="@color/colorPrimary" />

                <!-- 中：标题+副标题 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvLingshuTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_lingshu"
                        android:textSize="22sp"
                        android:textColor="@color/homeSuwenTitle"
                        android:typeface="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lingshu_subtitle"
                        android:textSize="13sp"
                        android:textColor="@color/homeSuwenSubtitle"
                        android:typeface="serif"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 右：统计+进度 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvLingshuCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/homeSuwenCount"
                        android:typeface="serif" />

                    <TextView
                        android:id="@+id/tvLingshuProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/homeSuwenProgress"
                        android:typeface="serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="→"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
