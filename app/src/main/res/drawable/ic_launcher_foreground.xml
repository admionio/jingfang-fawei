        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M30.4,25.9 Q28.1,29.8 30.4,34.9" />
        <!-- 右竖（镜像对称） -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M59.6,25.9 Q61.9,29.8 59.6,34.9" />

        <!-- 中部：田的篆形 — 圆角矩形 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M30.4,38.3 L59.6,38.3 Q62,38.3 62,40.5 L62,65 Q62,67.2 59.6,67.2 L30.4,67.2 Q28,67.2 28,65 L28,40.5 Q28,38.3 30.4,38.3 Z" />
