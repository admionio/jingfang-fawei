        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M45,37.1 Q45,40.5 45,43.9 Q45,50.6 45,65.2" />

        <!-- 底部：八的篆形 — 从田底向外弧出 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M34.9,64.1 Q30.4,69.8 27,75.9" />
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M55.1,64.1 Q59.6,69.8 63,75.9" />
    </group>
    </group>

    <!-- 底部文字"黄帝内经"（用路径绘制） -->
