    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 印章外框（朱砂红底色） -->
    <path
        android:fillColor="#C83C31"
        android:pathData="M3.4,3.4 L104.6,3.4 Q108,3.4 108,6.8 L108,101.2 Q108,104.6 104.6,104.6 L3.4,104.6 Q0,104.6 0,101.2 L0,6.8 Q0,3.4 3.4,3.4 Z" />

    <!-- 外金色边框（3px宽） -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#ECD396"
        android:strokeWidth="3"
        android:pathData="M4.5,4.5 L103.5,4.5 Q105,4.5 105,6 L105,102 Q105,103.5 103.5,103.5 L4.5,103.5 Q3,103.5 3,102 L3,6 Q3,4.5 4.5,4.5 Z" />

