        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M30.4,27 Q37.7,23.6 45,24.5 Q52.3,23.6 59.6,27" />
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#ECD396"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M30.4,33.8 Q37.7,31.5 45,31.5 Q52.3,31.5 59.6,33.8" />
